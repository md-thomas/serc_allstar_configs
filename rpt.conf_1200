;-------------------------------------------------------------------------------
; rpt.conf - Site 1 (Node 1200)
;-------------------------------------------------------------------------------

[1200]
rxchannel = SimpleUSB/usb1
duplex = 2
erxgain = -3
etxgain = 3
hangtime = 1000
altmode = 0
callerid = Repeater <000001200>
accountcode = RADIO

; Sub-stanza references
controlstates = controlstates1200
telemetry = telemetry1200
morse = morse1200
macro = macro1200
functions = functions1200
nodes = nodes

; Identification
idrecording = |iDE W4IE/R
idinterval = 600

[controlstates1200]
0 = rxtxcontrol,enable
1 = rxtxcontrol,disable

[telemetry1200]
telemain = |t(1000,0,100,2000)(0,0,0,0)
remotemon = |t(1200,0,100,2000)(0,0,0,0)
remotetx = |t(1200,0,100,2000)(0,0,0,0)

[morse1200]
speed = 20
frequency = 800
pitch = 800
weight = 50

[macro1200]
1 = *31201#
2 = *31202#

[functions1200]
1 = ilink,1
2 = ilink,2
3 = ilink,3
70 = ilink,5

;-------------------------------------------------------------------------------
; Global Routing Table
;-------------------------------------------------------------------------------
[nodes]
1200 = radio@127.0.0.1/1200,NONE        ; SMHS Node
1201 = radio@10.209.110.67/1201,NONE    ; SMHV Node
1202 = radio@10.14.182.250/1202,NONE    ; N4LPK Node
