;-------------------------------------------------------------------------------
; rpt.conf - Site 3 (Node 1202)
;-------------------------------------------------------------------------------

[1202]
rxchannel = SimpleUSB/usb1
duplex = 0
erxgain = -3
etxgain = 3
hangtime = 1000
altmode = 0
callerid = Repeater <000001202>
accountcode = RADIO

; Sub-stanza references
controlstates = controlstates1202
telemetry = telemetry1202
morse = morse1202
macro = macro1202
functions = functions1202
nodes = nodes

; Identification
idrecording = |iDE W4IE/R
idinterval = 600

[controlstates1202]
0 = rxtxcontrol,enable
1 = rxtxcontrol,disable

[telemetry1202]
telemain = |t(1000,0,100,2000)(0,0,0,0)
remotemon = |t(1200,0,100,2000)(0,0,0,0)
remotetx = |t(1200,0,100,2000)(0,0,0,0)

[morse1202]
speed = 20
frequency = 800
pitch = 800
weight = 50

[macro1202]
1 = *31200#
2 = *31201#

[functions1202]
1 = ilink,1
2 = ilink,2
3 = ilink,3
70 = ilink,5

;-------------------------------------------------------------------------------
; Global Routing Table
;-------------------------------------------------------------------------------
[nodes]
1200 = radio@10.166.232.76/1200,NONE    ; SMHS Node
1201 = radio@10.209.110.67/1201,NONE    ; SMHV Node
1202 = radio@127.0.0.1/1202,NONE        ; N4LPK Node
